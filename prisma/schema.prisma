// Prisma schema — defines your database tables and generates a type-safe client.
// Docs: https://pris.ly/d/prisma-schema
//
// After editing this file run:  npx prisma migrate dev --name <change-name>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Mirrors the objects in src/data/category.ts.
// "Y"/"N" flags are kept as String to match the existing API responses.
model Category {
  categoryId           Int     @id
  categoryName         String
  metaKeywords         String?
  metaTitle            String?
  description          String?
  metaDescription      String?
  parentCategoryId     Int?
  pictureId            Int?
  pageSize             Int?
  showOnHomepage       String?
  includeInTopMenu     String?
  isDeleted            String?
  displayOrder         Int?
  isActive             String?
  categoryUrl          String?
  imagePath            String?
  breadcrumbCategory   String?
  levelNo              String?
  isProduct            String?
  isReturnable         String?
  localCmsnPercentage  Float?
  localCmsnFlatAmt     Float?
  globalCmsnPercentage Float?
  globalCmsnFlatAmt    Float?
  isPopular            String?
  isNewArrival         String?
  isTopCategory        String?
  repalceCategoryUrl   String?
  brandId              Int?
  brandName            String?
  metaLongDescription  String?
  ogType               String?
  ogTitle              String?
  ogDescription        String?
  ogUrl                String?
  ogImgUrl             String?
  totalItems           Int?
  createdBy            String?
  createDate           String?
  updateBy             String?
  updateDate           String?

  products Product[]

  @@map("categories")
}

// Mirrors the objects in src/data/product.ts.
// Nested arrays/objects (images, variant dimensions/combinations) are stored as
// JSON columns so the API response shape stays identical to the mock data.
model Product {
  productId           Int                  @id @default(autoincrement())
  productName         String
  categoryId          Int
  unit                String?
  shopId              Int
  displayOrder        String?
  thumbnailImages     Json?
  brandId             Int
  strapMaterial       String?
  fitType             String?
  gender              String?
  variantDimensions   Json?
  variantImages       Json?
  variantCombinations VariantCombination[]
  // sku                 String?
  // subStyle            String?
  // stock               Int?
  // dpPrice             Float?
  // mrp                 Float?
  // sellingPrice        Float?
  // startDate           String?
  // endDate             String?
  description         String?
  specification       String?
  hasEmi              String?
  isReturnable        String?
  returnDuration      Int?
  returnPolicy        String?
  sizeChartId         Int?
  warrantyTypeId      Int?
  warrantyPeriodId    Int?
  warrantyPolicy      String?
  packageWeight       Float?
  packageLength       Float?
  packageWidth        Float?
  packageHeight       Float?
  productUrl          String?
  videoUrl            String?
  metaTitle           String?
  metaKeywords        String?
  metaDescription     String?
  ogType              String?
  ogTitle             String?
  ogUrl               String?
  ogDescription       String?
  ogImage             String?
  createdBy           String?
  createdAt           DateTime             @default(now())
  updatedBy           String?
  updatedAt           DateTime             @default(now()) @updatedAt
  status              String               @default("Y")

  category Category @relation(fields: [categoryId], references: [categoryId])
  shop     Shop     @relation(fields: [shopId], references: [shopId])
  brand    Brand    @relation(fields: [brandId], references: [brandId])

  @@unique([productId, shopId])
  @@index([shopId])
  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model VariantCombination {
  id               Int       @id @default(autoincrement())
  sku              String
  subStyle         String?
  shopProductSku   String?
  stock            Int
  dpPrice          Int
  mrp              Int
  sellingPrice     Int
  startDate        DateTime?
  endDate          DateTime?
  burnAmount       Int
  commissionAmount Int
  inventoryTypeId  Int
  status           String
  productId        Int
  shopId           Int

  product Product                    @relation(fields: [productId, shopId], references: [productId, shopId], onDelete: Cascade)
  options VariantCombinationOption[]

  @@unique([shopId, sku])
  @@index([shopId, shopProductSku])
  @@index([productId])
  @@map("variant_combinations")
}

model VariantCombinationOption {
  id                Int    @id @default(autoincrement())
  combinationId     Int
  variantOptionId   Int
  variantOptionText String

  variantCombination VariantCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)

  @@unique([combinationId, variantOptionId])
  @@map("variant_combination_options")
}

